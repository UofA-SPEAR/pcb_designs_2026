(version 1)
(rule MDI
	(condition "A.hasNetclass('MDI') && B.hasNetclass('MDI') && !AB.isCoupledDiffPair()")
	(constraint clearance (min 0.5mm)))
(rule "Tighten Gap in BGA Area"
    (condition "A.hasNetclass('MDI') && B.hasNetclass('MDI') && !AB.isCoupledDiffPair() && A.insideArea('Component')")
    (constraint clearance (min 0.18mm)))
(rule "Via Ring"
	(constraint annular_width (min 0.05mm))
	(condition "A.Type -- 'via'"))
(rule "PTH Ring"
	(constraint annular_width(min 0.18mm))
	(condition "A.Type -- 'pad'"))
